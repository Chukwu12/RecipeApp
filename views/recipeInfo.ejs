<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= recipe.title %>
    </title>
    <!-- Font-awesome -->
    <script src="https://kit.fontawesome.com/bb1892d46f.js" crossorigin="anonymous"></script>
    <!-- Glide.js CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.core.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/css/glide.theme.min.css">
    <!-- bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="recipe-info-page">
    <header id="main-nav">
        <div class="container-fluid">
            <nav class="navbar navbar-expand-md navbar-light bg-light">
                <a class="navbar-brand" href="/" aria-label="Homepage">
                    <img src="/image/onice-logo.png" alt="Onice Logo" height="30">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse " id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="/recipe">Recipes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/profile">Dashboard</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
    </header>



    <nav id="cuisenes">
        <div class="cuisenes">
            <div class="cuisnes-list">
                <div>
                    <h2>African</h2>
                    <a href="/cuisine/african"><img src="/image/african-icon.gif" alt="african food icon"></a>
                </div>
                <div>
                    <h2>American</h2>
                    <a href="/cuisine/american"><img src="/image/american-icon.gif" alt="american food icon"></a>
                </div>
                <div>
                    <h2>Asian</h2>
                    <a href="/cuisine/asian"><img src="/image/asian-icon.gif" alt="asian food icon"></a>
                </div>
                <div>
                    <h2>Mexican</h2>
                    <a href="/cuisine/mexican"><img src="/image/mexican-icon.gif" alt="mexican food icon"></a>
                </div>
            </div>
        </div>
    </nav>




    <main class="recipe-info-main">
    <section id="recipeInfo">
        <div class="recipeInfo-container">
            <header class="recipe-header">
                <div class="recipeInfo-details">
                    <p class="recipe-kicker">Recipe Details</p>
                    <h1>
                        <%= recipe.title %>
                    </h1>

                    <div class="recipe-meta-chips">
                        <p><i class="fa-regular fa-user"></i><span>Servings:</span>
                            <%= recipe.servings %>
                        </p>
                        <p><i class="fa-solid fa-clock"></i><span>Ready in:</span>
                            <%= recipe.readyInMinutes %> minutes
                        </p>
                    </div>
                </div>
                <figure>
                    <img src="<%= recipe.image %>" alt="<%= recipe.title %>" loading="lazy">
                </figure>
            </header>
            <div class="recipe-details">
                <section class="ingredients">
                    <h2>Ingredients</h2>
                    <ul>
                        <% if (Array.isArray(recipe.ingredients) && recipe.ingredients.length) { %>
                            <% recipe.ingredients.forEach(ingredient=> { %>
                                <li>
                                    <img src="/image/cooking-list-icon.png" alt="<%= ingredient.name || 'ingredient' %>">
                                    <%= ingredient.amount || '' %>
                                    <%= ingredient.unit || '' %>
                                    <%= ingredient.name || '' %>
                                </li>
                            <% }); %>
                        <% } else { %>
                            <li>Ingredient list is currently unavailable.</li>
                        <% } %>
                    </ul>
                </section>

                <section class="directions">
                    <h2>Instructions</h2>
                    <ol>
                        <% if (recipe.instructions) { %>
                            <% recipe.instructions.split(/\n|\.\s+/).filter(Boolean).forEach(function(step) { %>
                                <li><%- step.trim() %></li>
                            <% }); %>
                        <% } else { %>
                            <li>Instructions are currently unavailable.</li>
                        <% } %>
                    </ol>
                </section>
            </div>
            <!-- Back to Recipe Page -->
            <div id="recipeReturn-btn">
                <a href="/recipe">Back to Recipes</a>
            </div>
        </div>


    </section>
    </main>



    <!-- Glide.js -->
    <script src="https://cdn.jsdelivr.net/npm/@glidejs/glide/dist/glide.min.js"></script>
    <!-- Initialize Glide -->
    <!-- <script>
        new Glide('.glide', {
            type: 'carousel',
            startAt: 0,
            perView: 3,
            gap: 20
        }).mount();

       
    </script> -->

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
    <!-- Custom JS -->
    <script src="/js/main.js"></script>
</body>

</html>